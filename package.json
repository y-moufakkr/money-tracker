  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "android:build": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verify": "tsc --noEmit && jest"
